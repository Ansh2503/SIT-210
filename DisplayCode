
// ARDUINO 2 — DISPLAY UNIT (sits at front / driver position)
// Receives distance and zone data from MQTT broker
// Controls LCD, Green, Yellow, Red LEDs


#include <SPI.h>
#include <WiFiNINA.h>
#include <ArduinoMqttClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

//  WiFi credentials 
const char WIFI_SSID[] = "2002/33_Rose_Lane";
const char WIFI_PASS[] = "H@Dc!#G2Q9XcnJ63";

//  MQTT broker 
const char MQTT_BROKER[] = "broker.hivemq.com";
const int  MQTT_PORT     = 1883;
//Topics
const char TOPIC_DISTANCE[] = "sit210_Task11.1/distance";
const char TOPIC_ZONE[]     = "sit210_Task11.1/zone";

// Pin definitions 
#define GREEN_LED   4
#define YELLOW_LED  5
#define RED_LED     6

// LCD 
LiquidCrystal_I2C lcd(0x27, 16, 2);

// State received from sensing unit 
String receivedZone     = "WAITING";
String receivedDistance = "---";
String faultPinReceived = "";   // "D2", "D3", or ""
bool   newDataAvailable = false;

// Timing 
unsigned long lastDisplayUpdate = 0;
const long displayInterval      = 300;

unsigned long lastHeartbeat     = 0;
const long heartbeatInterval    = 5000;

// WiFi and MQTT 
WiFiClient wifiClient;
MqttClient mqttClient(wifiClient);


void setup() {
  Serial.begin(9600);

  pinMode(GREEN_LED,  OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(RED_LED,    OUTPUT);

  // Start LCD
  Wire.begin();
  delay(500);
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Display Unit    ");
  lcd.setCursor(0, 1);
  lcd.print("Connecting...   ");

  Serial.println("=== DISPLAY UNIT STARTING ===");

  // Connect to WiFi
  Serial.print("Connecting to WiFi: ");
  Serial.println(WIFI_SSID);

  while (WiFi.begin(WIFI_SSID, WIFI_PASS) != WL_CONNECTED) {
    Serial.print(".");
    delay(1000);
  }

  Serial.println();
  Serial.print("WiFi connected. IP: ");
  Serial.println(WiFi.localIP());

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("WiFi Connected  ");
  lcd.setCursor(0, 1);
  lcd.print("Linking MQTT... ");

  // Set MQTT message handler
  mqttClient.onMessage(onMqttMessage);

  // Connect to MQTT broker
  Serial.print("Connecting to MQTT: ");
  Serial.println(MQTT_BROKER);

  while (!mqttClient.connect(MQTT_BROKER, MQTT_PORT)) {
    Serial.print("MQTT failed. Error: ");
    Serial.println(mqttClient.connectError());
    delay(2000);
  }

  Serial.println("MQTT connected.");

  // Subscribe to both topics from sensing unit
  mqttClient.subscribe(TOPIC_DISTANCE);
  mqttClient.subscribe(TOPIC_ZONE);

  Serial.println("Subscribed to topics. Waiting for data...");

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("System Ready    ");
  lcd.setCursor(0, 1);
  lcd.print("Waiting...      ");
}


// MQTT MESSAGE HANDLER
// Called automatically when a message arrives on a subscribed
// topic.
// Zone payload format from sensing unit:
//   Normal zones : "SCANNING", "SAFE", "WARNING", "DANGER"
//   Fault zones  : "FAULT:D2" or "FAULT:D3"
//
// The colon-separated format lets us extract which pin failed
// and display a specific message on the LCD.

void onMqttMessage(int messageSize) {
  String topic   = mqttClient.messageTopic();
  String payload = "";

  while (mqttClient.available()) {
    payload += (char)mqttClient.read();
  }

  if (topic == TOPIC_ZONE) {

    // Check if this is a pin-specific fault message
    // Format: "FAULT:D2" or "FAULT:D3"
    if (payload.startsWith("FAULT:")) {
      receivedZone     = "FAULT";
      faultPinReceived = payload.substring(6);   // extract "D2" or "D3"
    } else {
      receivedZone     = payload;
      faultPinReceived = "";
    }

    newDataAvailable = true;

  } else if (topic == TOPIC_DISTANCE) {
    receivedDistance = payload;
  }

  Serial.print("[RECEIVED] Topic: ");
  Serial.print(topic);
  Serial.print(" | Value: ");
  Serial.println(payload);
}

// LED CONTROL

void setLEDs(bool green, bool yellow, bool red) {
  digitalWrite(GREEN_LED,  green  ? HIGH : LOW);
  digitalWrite(YELLOW_LED, yellow ? HIGH : LOW);
  digitalWrite(RED_LED,    red    ? HIGH : LOW);
}


// DISPLAY UPDATE
// Updates LCD and LEDs based on received zone.
//
// For FAULT zones, shows which pin needs checking:
//   FAULT:D2 → "Check pin D2"  (TRIG pin unplugged)
//   FAULT:D3 → "Check pin D3"  (ECHO pin unplugged)

void updateDisplay() {
  lcd.clear();

  if (receivedZone == "FAULT") {
    // All LEDs off — sensor cannot be trusted
    setLEDs(false, false, false);

    lcd.setCursor(0, 0);
    lcd.print("SENSOR FAULT!   ");

    lcd.setCursor(0, 1);
    if (faultPinReceived == "D2") {
      // TRIG pin (D2) is disconnected or giving bad signal
      lcd.print("Check pin D2    ");
    } else if (faultPinReceived == "D3") {
      // ECHO pin (D3) is disconnected — stuck LOW
      lcd.print("Check pin D3    ");
    } else {
      // Generic fallback if pin info was not received
      lcd.print("Check wiring    ");
    }

  } else if (receivedZone == "SCANNING") {
    lcd.setCursor(0, 0); lcd.print("Status:         ");
    lcd.setCursor(0, 1); lcd.print("Scanning...     ");
    setLEDs(true, false, false);

  } else if (receivedZone == "SAFE") {
    lcd.setCursor(0, 0);
    String line1 = "Dist: " + receivedDistance + " cm     ";
    lcd.print(line1.substring(0, 16));
    lcd.setCursor(0, 1); lcd.print("Status: SAFE    ");
    setLEDs(true, false, false);

  } else if (receivedZone == "WARNING") {
    lcd.setCursor(0, 0);
    String line1 = "Dist: " + receivedDistance + " cm     ";
    lcd.print(line1.substring(0, 16));
    lcd.setCursor(0, 1); lcd.print("Status: WARNING ");
    setLEDs(false, true, false);

  } else if (receivedZone == "DANGER") {
    lcd.setCursor(0, 0);
    String line1 = "Dist: " + receivedDistance + " cm     ";
    lcd.print(line1.substring(0, 16));
    lcd.setCursor(0, 1); lcd.print("Status: DANGER! ");
    setLEDs(false, false, true);

  } else {
    // Waiting for first message after boot
    lcd.setCursor(0, 0); lcd.print("Waiting for     ");
    lcd.setCursor(0, 1); lcd.print("Sensor Unit...  ");
    setLEDs(false, false, false);
  }
}


void loop() {
  // Keep MQTT connection alive and process incoming messages
  mqttClient.poll();

  // Reconnect if dropped
  if (!mqttClient.connected()) {
    Serial.println("MQTT lost. Reconnecting...");
    lcd.clear();
    lcd.setCursor(0, 0); lcd.print("WiFi Lost...    ");
    lcd.setCursor(0, 1); lcd.print("Reconnecting... ");
    setLEDs(false, false, false);

    while (!mqttClient.connect(MQTT_BROKER, MQTT_PORT)) {
      delay(2000);
    }
    mqttClient.subscribe(TOPIC_DISTANCE);
    mqttClient.subscribe(TOPIC_ZONE);
    Serial.println("Reconnected.");
  }

  // Update display every 300ms
  unsigned long currentMillis = millis();
  if (currentMillis - lastDisplayUpdate >= displayInterval) {
    lastDisplayUpdate = currentMillis;
    updateDisplay();
  }

  // Heartbeat log every 5 seconds
  if (currentMillis - lastHeartbeat >= heartbeatInterval) {
    lastHeartbeat = currentMillis;
    Serial.print("[HEARTBEAT] Zone: ");
    Serial.print(receivedZone);
    if (receivedZone == "FAULT" && faultPinReceived != "") {
      Serial.print(" | Fault pin: ");
      Serial.print(faultPinReceived);
    }
    Serial.print(" | Distance: ");
    Serial.print(receivedDistance);
    Serial.print(" | Time: ");
    Serial.print(millis());
    Serial.println("ms");
  }
}
