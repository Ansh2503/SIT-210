
// ARDUINO 2 — DISPLAY UNIT 
// Location: Driver position / front of garage
//
// LCD now shows everything( which was previously only visible on terminal):
//   - Live received zone and distance
//   - Message receive confirmation
//   - WiFi and MQTT connection status
//   - Last message timestamp
//   - Fault pin identification
//   - Signal lost warning
//
// Row 1: Current zone and distance (always visible)
// Row 2: Cycles through status info every 2 seconds


#include <SPI.h>
#include <WiFiNINA.h>
#include <ArduinoMqttClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

//WiFi credentials 
const char WIFI_SSID[] = "2002/33_Rose_Lane";
const char WIFI_PASS[] = "H@Dc!#G2Q9XcnJ63";
 //MQTT broker 
const char MQTT_BROKER[] = "broker.hivemq.com";
const int  MQTT_PORT     = 1883;

const char TOPIC_DISTANCE[] = "sit210_Task11.1/distance";
const char TOPIC_ZONE[]     = "sit210_Task11.1/zone";

// Pin definitions 
#define LED_GREEN    4
#define LED_YELLOW   5
#define LED_RED      6
#define BUZZER_PIN   7

//LCD 
LiquidCrystal_I2C lcd(0x27, 16, 2);

// Received state 
String receivedZone       = "WAITING";
String receivedDistance   = "---";
String faultPinReceived   = "";
int    messageCount       = 0;       // counts total messages received
unsigned long lastMessageTime = 0;   // millis when last message arrived

//  LCD row 2 cycling 
// Row 2 cycles through different status screens every 2 seconds
// so the user can see all the communication info on the LCD
int    lcdCycleIndex      = 0;
const int LCD_CYCLE_COUNT = 4;       // number of different row 2 screens
unsigned long lastCycleSwitch = 0;
const long cycleSwitchInterval = 2000;  // switch every 2 seconds

// Timing 
unsigned long lastDisplayUpdate  = 0;
const long    displayInterval    = 300;

unsigned long lastHeartbeat      = 0;
const long    heartbeatInterval  = 5000;

const long    messageTimeout     = 5000;  // signal lost after 5s no message

//  Connection state 
bool wifiConnected  = false;
bool mqttConnected  = false;

// WiFi and MQTT 
WiFiClient wifiClient;
MqttClient mqttClient(wifiClient);



void lcdRow(int row, String text) {
  while (text.length() < 16) text += " ";
  lcd.setCursor(0, row);
  lcd.print(text.substring(0, 16));
}


void setup() {
  Serial.begin(9600);

  pinMode(LED_GREEN,  OUTPUT);
  pinMode(LED_YELLOW, OUTPUT);
  pinMode(LED_RED,    OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  Wire.begin();
  delay(500);
  lcd.init();
  lcd.backlight();
  lcd.clear();

  lcdRow(0, "Display Unit");
  lcdRow(1, "Starting...");

  // Startup LED and buzzer test
  digitalWrite(LED_GREEN,  HIGH);
  digitalWrite(LED_YELLOW, HIGH);
  digitalWrite(LED_RED,    HIGH);
  tone(BUZZER_PIN, 1000, 300);
  delay(700);
  digitalWrite(LED_GREEN,  LOW);
  digitalWrite(LED_YELLOW, LOW);
  digitalWrite(LED_RED,    LOW);

  Serial.println("===========================================");
  Serial.println("  DISPLAY UNIT — Smart Distance Monitor");
  Serial.println("  SIT210 Embedded Systems Development");
  Serial.println("===========================================");

  connectWifi();
  mqttClient.onMessage(onMqttMessage);
  if (wifiConnected) connectMqtt();
}

// ────────────────────────────────────────────────────────────
// WiFi CONNECTION
// ────────────────────────────────────────────────────────────
void connectWifi() {
  Serial.print("[WIFI] Connecting to: ");
  Serial.println(WIFI_SSID);

  lcdRow(0, "Connecting WiFi");
  lcdRow(1, String(WIFI_SSID).substring(0, 16));

  int attempts = 0;
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  while (WiFi.status() != WL_CONNECTED && attempts < 15) {
    delay(1000);
    Serial.print(".");
    attempts++;

    // Show attempt count on LCD row 2 so user can see progress
    lcdRow(1, "Attempt " + String(attempts) + "/15   ");
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
    Serial.println();
    Serial.print("[WIFI] Connected. IP: ");
    Serial.println(WiFi.localIP());

    lcdRow(0, "WiFi Connected!");
    lcdRow(1, WiFi.localIP().toString());
    delay(2000);

  } else {
    wifiConnected = false;
    Serial.println();
    Serial.println("[WIFI] Connection FAILED.");

    // Showing wifi  failure clearly on LCD 
    lcdRow(0, "WIFI FAILURE!   ");
    lcdRow(1, "Check Network   ");

    // Three beeps for WiFi failure
    for (int i = 0; i < 3; i++) {
      tone(BUZZER_PIN, 500, 200);
      delay(400);
    }
    delay(3000);
  }
}


// MQTT CONNECTION

void connectMqtt() {
  Serial.print("[MQTT] Connecting to: ");
  Serial.println(MQTT_BROKER);

  lcdRow(0, "Linking MQTT... ");
  lcdRow(1, MQTT_BROKER);

  if (mqttClient.connect(MQTT_BROKER, MQTT_PORT)) {
    mqttConnected = true;
    Serial.println("[MQTT] Connected.");

    mqttClient.subscribe(TOPIC_DISTANCE);
    mqttClient.subscribe(TOPIC_ZONE);
    Serial.println("[MQTT] Subscribed to topics.");

    // Show MQTT success on LCD
    lcdRow(0, "MQTT Connected! ");
    lcdRow(1, "Waiting Data... ");
    delay(1500);

    lastMessageTime = millis();

  } else {
    mqttConnected = false;
    Serial.print("[MQTT] Failed. Error: ");
    Serial.println(mqttClient.connectError());

    // Show MQTT failure on LCD
    lcdRow(0, "MQTT FAILURE!   ");
    lcdRow(1, "Check Broker    ");
    delay(3000);
  }
}


// MQTT MESSAGE HANDLER
// Updates received state and logs to LCD + Serial

void onMqttMessage(int messageSize) {
  String topic   = mqttClient.messageTopic();
  String payload = "";

  while (mqttClient.available()) {
    payload += (char)mqttClient.read();
  }

  if (topic == TOPIC_ZONE) {
    if (payload.startsWith("FAULT:")) {
      receivedZone     = "FAULT";
      faultPinReceived = payload.substring(6);
    } else {
      receivedZone     = payload;
      faultPinReceived = "";
    }
  } else if (topic == TOPIC_DISTANCE) {
    receivedDistance = payload;
  }

  lastMessageTime = millis();
  messageCount++;

  // Log to Serial
  Serial.print("[RECEIVED] Topic: ");
  Serial.print(topic);
  Serial.print(" | Value: ");
  Serial.print(payload);
  Serial.print(" | Msg #");
  Serial.println(messageCount);
}


// LED CONTROL

void setLEDs(bool green, bool yellow, bool red) {
  digitalWrite(LED_GREEN,  green  ? HIGH : LOW);
  digitalWrite(LED_YELLOW, yellow ? HIGH : LOW);
  digitalWrite(LED_RED,    red    ? HIGH : LOW);
}


// BUZZER CONTROL

void runLocalBuzzer(String zone) {
  if (zone == "WARNING")      tone(BUZZER_PIN, 1000, 50);
  else if (zone == "DANGER")  tone(BUZZER_PIN, 1600);
  else                        noTone(BUZZER_PIN);
}


// BUILD ROW 1 — always shows zone and distance

String buildRow1() {
  unsigned long now = millis();

  // No WiFi
  if (!wifiConnected || WiFi.status() != WL_CONNECTED) {
    return "WIFI FAILURE!   ";
  }
  // No MQTT
  if (!mqttClient.connected()) {
    return "MQTT Lost!      ";
  }
  // Signal lost — no message for 5 seconds
  if (receivedZone != "WAITING" && (now - lastMessageTime > messageTimeout)) {
    return "Signal Lost!    ";
  }
  // Fault state
  if (receivedZone == "FAULT") {
    return "SENSOR FAULT!   ";
  }
  // Waiting for first message
  if (receivedZone == "WAITING") {
    return "Waiting...      ";
  }
  // Normal — shows distance and zone
  if (receivedDistance == "---") {
    return receivedZone + "            ";
  }
  return "D:" + receivedDistance + "cm " + receivedZone + "  ";
}


// BUILD ROW 2 — cycles through status info
// now visible on the LCD for the user to see
//
// Cycle 0: Received message info — "Recv:SAFE 45cm"
// Cycle 1: WiFi status          — "WiFi:Connected"
// Cycle 2: MQTT status          — "MQTT:Connected"
// Cycle 3: Message count        — "Msgs:42 OK"
//          Or fault pin         — "Fault:D3 Recv'd"
//          Or signal lost       — "No Signal 5s"
String buildRow2(int cycleIndex) {
  unsigned long now = millis();

  // If WiFi failed — always show WiFi status info
  if (!wifiConnected || WiFi.status() != WL_CONNECTED) {
    switch (cycleIndex % 2) {
      case 0: return "WiFi:FAILED     ";
      case 1: return "Check Network   ";
    }
  }

  // If MQTT failed
  if (!mqttClient.connected()) {
    switch (cycleIndex % 2) {
      case 0: return "MQTT:FAILED     ";
      case 1: return "Check Broker    ";
    }
  }

  // If fault state — show fault pin info prominently
  if (receivedZone == "FAULT") {
    switch (cycleIndex % 3) {
      case 0: return "Fault:" + faultPinReceived + " Recvd  ";
      case 1: return "Check Pin " + faultPinReceived + "     ";
      case 2: return "Msgs:" + String(messageCount) + " recvd  ";
    }
  }

  // If signal lost
  if (receivedZone != "WAITING" && (now - lastMessageTime > messageTimeout)) {
    long secsLost = (now - lastMessageTime) / 1000;
    switch (cycleIndex % 2) {
      case 0: return "No Signal " + String(secsLost) + "s   ";
      case 1: return "Chk Sensor Unit ";
    }
  }

  // Normal cycling — show all terminal info on LCD
  switch (cycleIndex % LCD_CYCLE_COUNT) {

    case 0:
      // What was just received — mirrors terminal [RECEIVED] line
      if (receivedZone == "WAITING") return "Waiting for msg ";
      return "Recv:" + receivedZone + " " + receivedDistance + "cm  ";

    case 1:
      // WiFi connection status — mirrors terminal [WIFI] line
      if (wifiConnected) {
        String ip = WiFi.localIP().toString();
        return "WiFi:OK " + ip.substring(ip.lastIndexOf('.')+1);
      }
      return "WiFi:FAILED     ";

    case 2:
      // MQTT connection status — mirrors terminal [MQTT] line
      if (mqttConnected && mqttClient.connected()) {
        return "MQTT:Connected  ";
      }
      return "MQTT:FAILED     ";

    case 3:
      // Message count — shows data is flowing
      return "Msgs:" + String(messageCount) + " recvd   ";

    default:
      return "                ";
  }
}


// MAIN DISPLAY UPDATE
// Row 1 always shows current zone and distance
// Row 2 cycles through received, WiFi, MQTT, message count
void updateDisplay() {
  unsigned long now = millis();

  // Advance the LCD row 2 cycle every 2 seconds
  if (now - lastCycleSwitch >= cycleSwitchInterval) {
    lastCycleSwitch = now;
    lcdCycleIndex   = (lcdCycleIndex + 1) % LCD_CYCLE_COUNT;
  }

  // Build and print both rows
  lcdRow(0, buildRow1());
  lcdRow(1, buildRow2(lcdCycleIndex));

  // Update LEDs and buzzer based on zone
  if (!wifiConnected || !mqttClient.connected()) {
    setLEDs(false, false, false);
    noTone(BUZZER_PIN);
  } else if (receivedZone == "FAULT") {
    setLEDs(false, false, false);
    noTone(BUZZER_PIN);
  } else if (receivedZone == "SCANNING" || receivedZone == "SAFE") {
    setLEDs(true, false, false);
    noTone(BUZZER_PIN);
  } else if (receivedZone == "WARNING") {
    setLEDs(false, true, false);
    runLocalBuzzer("WARNING");
  } else if (receivedZone == "DANGER") {
    setLEDs(false, false, true);
    runLocalBuzzer("DANGER");
  } else {
    setLEDs(false, false, false);
    noTone(BUZZER_PIN);
  }
}


void loop() {
  unsigned long currentMillis = millis();

  // Process incoming MQTT messages
  if (wifiConnected && mqttClient.connected()) {
    mqttClient.poll();
  }

  // Handle MQTT reconnection
  if (wifiConnected && !mqttClient.connected()) {
    Serial.println("[MQTT] Lost — reconnecting...");
    mqttConnected = false;
    if (mqttClient.connect(MQTT_BROKER, MQTT_PORT)) {
      mqttConnected = true;
      mqttClient.subscribe(TOPIC_DISTANCE);
      mqttClient.subscribe(TOPIC_ZONE);
      Serial.println("[MQTT] Reconnected.");
    }
  }

  // Handle WiFi reconnection
  if (WiFi.status() != WL_CONNECTED) {
    if (wifiConnected) {
      Serial.println("[WIFI] Connection lost.");
      wifiConnected = false;
    }
  }

  // Update display every 300ms
  if (currentMillis - lastDisplayUpdate >= displayInterval) {
    lastDisplayUpdate = currentMillis;
    updateDisplay();
  }

  // Heartbeat — log to Serial AND the LCD row 2 will show it
  if (currentMillis - lastHeartbeat >= heartbeatInterval) {
    lastHeartbeat = currentMillis;
    Serial.print("[HEARTBEAT] Zone:");
    Serial.print(receivedZone);
    Serial.print(" Dist:");
    Serial.print(receivedDistance);
    Serial.print(" WiFi:");
    Serial.print(wifiConnected ? "OK" : "FAILED");
    Serial.print(" MQTT:");
    Serial.print(mqttConnected ? "OK" : "FAILED");
    Serial.print(" Msgs:");
    Serial.print(messageCount);
    Serial.print(" Time:");
    Serial.print(millis());
    Serial.println("ms");
  }
}
