#include "thingProperties.h"

// LED pins
const int livingRoomPin = 5;
const int bathroomPin   = 6;
const int closetPin     = 7;

void setup() {
  Serial.begin(9600);
  delay(1500);

  pinMode(livingRoomPin, OUTPUT);
  pinMode(bathroomPin, OUTPUT);
  pinMode(closetPin, OUTPUT);

  // Init cloud connection
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  Serial.println("Connected to Arduino IoT Cloud");
}

void loop() {
  ArduinoCloud.update();
}

// ===== CLOUD FUNCTIONS =====
// These are triggered automatically when cloud variables change

void onLivingRoomChange() {
  digitalWrite(livingRoomPin, livingRoom ? HIGH : LOW);
}

void onBathroomChange() {
  digitalWrite(bathroomPin, bathroom ? HIGH : LOW);
}

void onClosetChange() {
  digitalWrite(closetPin, closet ? HIGH : LOW);
}
