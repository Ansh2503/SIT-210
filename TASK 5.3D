#include <WiFiNINA.h>


const char* ssid = "TP-Link_EE15";
const char* password = "14004209";

// Pins for LEDs
const int livingRoomPin = 5;
const int bathroomPin   = 6;
const int closetPin     = 7;

// Create a server on port 80
WiFiServer server(80);

void setup() {
  Serial.begin(9600);

  // Initialize LED pins
  pinMode(livingRoomPin, OUTPUT);
  pinMode(bathroomPin, OUTPUT);
  pinMode(closetPin, OUTPUT);

  // Connect to Wi-Fi
  Serial.print("Connecting to Wi-Fi...");
  while (WiFi.begin(ssid, password) != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  server.begin(); // Start the server
}

void loop() {
  WiFiClient client = server.available(); // Listen for incoming clients
  //request recieved validation
  if (client) {
    String request = client.readStringUntil('\r');//Read http request
    Serial.println(request);// prints the incoming request fromm http
    client.flush();// clears rest of the remaining data

    // Parse LED control from URL
    if (request.indexOf("/?led=livingroom&state=1") != -1) digitalWrite(livingRoomPin, HIGH);//checks if the request recieved is in the form of string and match the request asked for
    if (request.indexOf("/?led=livingroom&state=0") != -1) digitalWrite(livingRoomPin, LOW);

    if (request.indexOf("/?led=bathroom&state=1") != -1) digitalWrite(bathroomPin, HIGH);
    if (request.indexOf("/?led=bathroom&state=0") != -1) digitalWrite(bathroomPin, LOW);

    if (request.indexOf("/?led=closet&state=1") != -1) digitalWrite(closetPin, HIGH);
    if (request.indexOf("/?led=closet&state=0") != -1) digitalWrite(closetPin, LOW);

    // Send basic HTTP response
    client.println("HTTP/1.1 200 OK");//confirm successfull operation 
    client.println("Content-Type: text/html");// tell browser that it is html
    client.println();
    client.println("<h1>LED Control</h1>");
    client.println("<p>Use the HTML page to toggle LEDs.</p>");
    client.stop();
  }
}
