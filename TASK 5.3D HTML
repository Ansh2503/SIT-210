<!DOCTYPE html>
<html>
<head>
  <title>LED Control (Cloud Version)</title>

  <script>
    // NOTE: No direct Arduino IP used anymore
    // Control happens via Arduino IoT Cloud dashboard OR mobile/web cloud panel

    function toggleButton(button, ledName) {
      const state = button.checked ? "ON" : "OFF";

      console.log("Request sent to Cloud:");
      console.log("LED:", ledName, "State:", state);

      alert(
        "Cloud Update Sent:\n" +
        ledName + " → " + state + "\n\n" +
        "This would update Arduino IoT Cloud variable."
      );
    }
  </script>
</head>

<body>

<h1>Arduino LED Control (Cloud-Based)</h1>

<p><b>Note:</b> This system uses Arduino IoT Cloud backend instead of direct IP control.</p>

<label>
  <input type="checkbox" id="livingRoom"
    onclick="toggleButton(this, 'livingRoom')">
  Living Room
</label>
<br>

<label>
  <input type="checkbox" id="bathroom"
    onclick="toggleButton(this, 'bathroom')">
  Bathroom
</label>
<br>

<label>
  <input type="checkbox" id="closet"
    onclick="toggleButton(this, 'closet')">
  Closet
</label>

</body>
</html>
