<!DOCTYPE html>
<html>
<head>
  <title>Smart Home Control (Cloud System)</title>

  <script>

    function toggleRoom(room, state) {

      // This represents frontend interaction
      console.log("Web UI Triggered:");
      console.log(room + " = " + state);

      alert(
        "Send this value to Arduino Cloud Dashboard:\n\n" +
        room + " = " + state +
        "\n\nCloud backend will update Arduino automatically."
      );

     
    }

  </script>
</head>

<body>

<h2>🏠 Smart Home Control System</h2>

<label>
  <input type="checkbox"
         onclick="toggleRoom('livingRoom', this.checked)">
  Living Room
</label>

<br><br>

<label>
  <input type="checkbox"
         onclick="toggleRoom('bathroom', this.checked)">
  Bathroom
</label>

<br><br>

<label>
  <input type="checkbox"
         onclick="toggleRoom('closet', this.checked)">
  Closet
</label>

</body>
</html>
