import speech_recognition as sr
import asyncio
from bleak import BleakClient
import time

ARDUINO_MAC = "EC:62:60:8F:49:2E"
CHAR_UUID = "19B10001-E8F2-537E-4F6C-D104768A1214"

def listen_for_command():
    recognizer = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        recognizer.adjust_for_ambient_noise(source, duration=1)
        audio = recognizer.listen(source, timeout=5)
    try:
        text = recognizer.recognize_google(audio).lower()
        print(f"Heard: {text}")
        return text
    except:
        print("Could not understand")
        return ""

def get_command(text):
    if "lights on" in text or "turn on" in text or "light on" in text:
        return "L"
    elif "lights off" in text or "turn off" in text or "light off" in text:
        return "X"
    elif "fan on" in text or "start fan" in text:
        return "F"
    elif "fan off" in text or "stop fan" in text:
        return "G"
    return None

async def main():
    print("Connecting to Arduino...")
    async with BleakClient(ARDUINO_MAC) as client:
        print("Connected!")
        while True:
            text = listen_for_command()
            if text:
                cmd = get_command(text)
                if cmd:
                    await client.write_gatt_char(CHAR_UUID, cmd.encode())
                    print(f"Sent: {cmd}")
            await asyncio.sleep(0.5)

asyncio.run(main())
