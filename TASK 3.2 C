#include <WiFiNINA.h>
#include <PubSubClient.h>

// ===== WiFi Credentials =====
const char* ssid = "TP-Link_EE15";
const char* password = "14004209";

// ===== HiveMQ Cloud MQTT =====
const char* mqttServer = "080b491ea779488d806806d7d60063a2.s1.eu.hivemq.cloud";
const int mqttPort = 8883;              // SSL port
const char* mqttUser = "Ansh2503";      // HiveMQ username
const char* mqttPassword = "Ansh@2503"; // HiveMQ password

// ===== Ultrasonic Sensor Pins =====
const int trigPin = 7;
const int echoPin = 3;

// ===== LED Pins =====
const int led1 = 5;
const int led2 = 6;

// ===== MQTT Client =====
WiFiSSLClient wifiClient;   // Secure client for Nano 33 IoT
PubSubClient mqttClient(wifiClient);

// ===== Distance Measurement =====
long duration;
int distance;

// ===== Detection States =====
bool waveDetected = false;
bool patDetected = false;

// ===== Cooldown =====
unsigned long lastPublishTime = 0;
const unsigned long publishCooldown = 2000; // 2 seconds

// ===== Function Prototypes =====
void connectWiFi();
void connectMQTT();
void mqttCallback(char* topic, byte* payload, unsigned int length);

void setup() {
  Serial.begin(9600);

  // ===== Pin Setup =====
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);

  // ===== Connect WiFi and MQTT =====
  connectWiFi();
  mqttClient.setServer(mqttServer, mqttPort);
  mqttClient.setCallback(mqttCallback);
}

void loop() {
  if (!mqttClient.connected()) {
    connectMQTT();
  }
  mqttClient.loop();

  // ===== Measure Distance =====
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH);
  distance = duration * 0.034 / 2; // cm

  if (distance > 0) Serial.print("Distance: "); Serial.println(distance);

  unsigned long currentTime = millis();

  // ===== Wave Detection (<=10 cm) =====
  if (distance > 0 && distance <= 10 && !waveDetected && currentTime - lastPublishTime > publishCooldown) {
    mqttClient.publish("ES/Wave", "Wave detected by Linda");
    Serial.println("Wave published to ES/Wave");
    waveDetected = true;
    patDetected = false;
    lastPublishTime = currentTime;
  }
  // ===== Pat Detection (11-20 cm) =====
  else if (distance > 10 && distance <= 20 && !patDetected && currentTime - lastPublishTime > publishCooldown) {
    mqttClient.publish("ES/Pat", "Pat detected by Linda");
    Serial.println("Pat published to ES/Pat");
    patDetected = true;
    waveDetected = false;
    lastPublishTime = currentTime;
  }
  else if (distance > 20 || distance == 0) {
    // Reset detection states when nothing is near
    waveDetected = false;
    patDetected = false;
  }

  delay(500); // slow down loop, 2 readings per second
}

// ===== Connect to WiFi =====
void connectWiFi() {
  Serial.print("Connecting to WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println(" Connected!");
}

// ===== Connect to HiveMQ Cloud =====
void connectMQTT() {
  while (!mqttClient.connected()) {
    Serial.println("Connecting to MQTT...");
    if (mqttClient.connect("ArduinoNano33Client", mqttUser, mqttPassword)) {
      Serial.println("Connected to HiveMQ Cloud");
      mqttClient.subscribe("ES/Wave");
      mqttClient.subscribe("ES/Pat");
    } else {
      Serial.print("Failed, rc=");
      Serial.print(mqttClient.state());
      Serial.println(" retrying in 2 seconds");
      delay(2000);
    }
  }
}

// ===== MQTT Callback for LED Control =====
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String message;
  for (int i = 0; i < length; i++) {
    message += (char)payload[i];
  }

  Serial.print("Message received on topic: ");
  Serial.println(topic);
  Serial.println("Message: " + message);

  if (String(topic) == "ES/Wave" && digitalRead(led1) == LOW) {
    digitalWrite(led1, HIGH);
    digitalWrite(led2, HIGH);
    Serial.println("LEDs turned ON");
  }

  if (String(topic) == "ES/Pat" && digitalRead(led1) == HIGH) {
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);
    Serial.println("LEDs turned OFF");
  }
}
