#ifndef THINGPROPERTIES_H
#define THINGPROPERTIES_H

#include <ArduinoIoTCloud.h>
#include <Arduino_ConnectionHandler.h>
#include <WiFiNINA.h>

// ===== Callback declarations =====
void onLivingRoomChange();
void onBathroomChange();
void onClosetChange();

// ===== Cloud variables =====
extern bool livingRoom;
extern bool bathroom;
extern bool closet;

// WiFi connection handler
WiFiConnectionHandler ArduinoIoTPreferredConnection;

// ===== Cloud setup =====
void initProperties() {

  ArduinoCloud.setThingId("3693502f-cba4-444f-9e55-7f1297ab9b32");

  ArduinoCloud.addProperty(livingRoom, READWRITE, ON_CHANGE, onLivingRoomChange);
  ArduinoCloud.addProperty(bathroom, READWRITE, ON_CHANGE, onBathroomChange);
  ArduinoCloud.addProperty(closet, READWRITE, ON_CHANGE, onClosetChange);

}

#endif
